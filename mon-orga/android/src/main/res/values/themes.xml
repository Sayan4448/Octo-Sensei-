<resources>
    <!-- The interface is a web page: the window only paints the right background behind it, light or dark. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="AlarmTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/alarm_bg</item>
        <item name="android:statusBarColor">@color/alarm_bg</item>
        <item name="android:navigationBarColor">@color/alarm_bg</item>
    </style>

    <!-- "Later…": a small dialog over whatever is on screen. -->
    <style name="SnoozeTheme" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="windowNoTitle">true</item>
    </style>

    <color name="ic_launcher_background">#6750A4</color>
</resources>
